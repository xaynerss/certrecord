PORT=3000
JWT_SECRET=certrecord-dev-secret-change-me
DATABASE_URL=postgresql://certrecord:certrecord@localhost:5432/certrecord

# SMTP mail.ru — общий сервис, письма уходят людям с этого адреса
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=certrecord@mail.ru
SMTP_PASS=
SMTP_FROM=certrecord@mail.ru

# Scanner defaults
SCAN_DEFAULT_PORT=443
SCAN_TIMEOUT_MS=6000
SCAN_CONCURRENCY=20
